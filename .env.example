# Docker 部署环境变量示例，不包含全部 Nacos 业务配置。
# 在仓库根目录复制为 .env，修改后通过 Bash 加载：
# set -a
# source ./.env
# set +a
# bash builds/script/docker/deploy.sh deploy
# 部署脚本不会显式加载根目录 .env；仅复制文件不足以让脚本读取这些变量。
# 此文件同时作为 Bash 配置使用，含特殊字符的值请用单引号包裹。

COMPOSE_PROJECT_NAME=mesh-platform

# 首次部署前替换以下占位密码。不要提交实际密码。
# 已有 MySQL 数据目录不会因修改此值而自动更新数据库账户密码。
MYSQL_PASSWORD='replace_with_mysql_password'
REDIS_PASSWORD='replace_with_redis_password'

# 0：在 Maven 容器中构建源码；1：使用宿主机 Maven 构建源码。
# 前端产物仍需提前放入 builds/web。
BUILD_LOCAL=0

# 部署脚本从宿主机访问 Nacos、导入配置所用地址，不是容器内的服务地址。
NACOS_SERVER_ADDR=http://127.0.0.1:8848

# 导入 Nacos 配置时替换默认 CRM MCP 地址，供容器内服务访问。
MCP_CRM_URL=http://mesh-crm:8090/mcp
