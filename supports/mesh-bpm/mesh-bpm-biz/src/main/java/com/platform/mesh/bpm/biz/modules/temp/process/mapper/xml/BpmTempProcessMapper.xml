<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.bpm.biz.modules.temp.process.mapper.BpmTempProcessMapper">


    <select id="selectMPage"
            resultType="com.platform.mesh.bpm.biz.modules.temp.process.domain.vo.BpmTempProcessVO">
        SELECT
            p.*,
            gr.group_id,
            fr.module_id
        FROM
            bpm_temp_process p
            LEFT JOIN bpm_all_group_rel gr ON p.id = gr.data_id
            LEFT JOIN bpm_data_form_rel fr ON p.id = fr.temp_process_id
        <where>
            p.temp_root_id = 0
            <if test="pageDTO.groupId != null">
                AND gr.group_id = #{pageDTO.groupId}
            </if>
            <if test="pageDTO.moduleId != null">
                AND fr.module_id = #{pageDTO.moduleId}
            </if>
            <if test="pageDTO.processHash != null and pageDTO.processHash != ''">
                AND p.process_hash = #{pageDTO.processHash}
            </if>
            <if test="pageDTO.processVersion != null and pageDTO.processVersion != ''">
                AND p.process_version = #{pageDTO.processVersion}
            </if>
            <if test="pageDTO.processName != null and pageDTO.processName != ''">
                AND p.process_name LIKE CONCAT('%',#{pageDTO.processName},'%')
            </if>
        </where>
    </select>
</mapper>
