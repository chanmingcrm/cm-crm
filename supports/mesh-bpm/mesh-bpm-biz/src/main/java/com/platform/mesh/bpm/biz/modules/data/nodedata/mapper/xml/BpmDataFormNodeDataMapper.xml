<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.bpm.biz.modules.data.nodedata.mapper.BpmDataFormNodeDataMapper">


    <select id="getLastDataFormNodeDataByInstProcessId"
            resultType="com.platform.mesh.bpm.biz.modules.data.nodedata.domain.po.BpmDataFormNodeData">
        SELECT
            *
        FROM
            bpm_data_form_node_data
        WHERE
            inst_process_id = #{instProcessId}
        ORDER BY create_time DESC
        LIMIT 1
    </select>
</mapper>