<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.sys.role.mapper.SysRoleMapper">


    <select id="getRoleInfoByUserId" resultType="com.platform.mesh.upms.biz.modules.sys.role.domain.po.SysRole">
        SELECT
            r.*
        FROM
            sys_user_role_rel urr
                LEFT JOIN sys_role r ON urr.role_id = r.id
        WHERE
            urr.user_id = #{userId}
            AND r.del_flag = #{delFlag}
    </select>
</mapper>
