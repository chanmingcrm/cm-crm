<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.dict.value.mapper.DictValueMapper">


    <select id="getFistSysDictByMac"
            resultType="com.platform.mesh.upms.biz.modules.dict.value.domain.po.DictValue">
        SELECT
            *
        FROM
            dict_value
        WHERE
            dict_mac = #{dictMac}
        AND dict_value = #{dictValue}
        LIMIT 1
    </select>
</mapper>