<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.doc.pub.mapper.DocPubMapper">

    <select id="getByTenantId" resultType="com.platform.mesh.upms.biz.modules.doc.pub.domain.po.DocPub">
        SELECT
            *
        FROM
            doc_pub
        WHERE
            tenant_id = #{tenantId}
        LIMIT 1
    </select>
</mapper>