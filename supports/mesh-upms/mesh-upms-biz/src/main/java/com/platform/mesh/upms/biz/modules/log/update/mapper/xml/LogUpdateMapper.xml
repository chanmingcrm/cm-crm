<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.log.update.mapper.LogUpdateMapper">

    <select id="getLastOne" resultType="com.platform.mesh.upms.biz.modules.log.update.domain.po.LogUpdate">
        SELECT
            *
        FROM
            log_update
        WHERE log_flag = #{logFLag}
        ORDER BY
            create_time DESC
        LIMIT 1
    </select>
</mapper>
