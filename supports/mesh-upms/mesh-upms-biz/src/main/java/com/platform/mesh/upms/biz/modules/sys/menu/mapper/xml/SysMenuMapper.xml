<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.sys.menu.mapper.SysMenuMapper">

    <select id="getMenuPage" resultType="com.platform.mesh.upms.biz.modules.sys.menu.domain.po.SysMenu">
        SELECT DISTINCT
            m.*
        FROM
            sys_menu m
        WHERE m.del_flag != #{pageDTO.delFlag}
        <if test="pageDTO.parentId != null">
            AND m.parent_id = #{pageDTO.parentId}
        </if>
        <if test="pageDTO.menuType != null">
            AND m.menu_type = #{pageDTO.menuType}
        </if>
    </select>

    <select id="getMenuInfo"
            resultType="com.platform.mesh.upms.biz.modules.sys.menu.domain.po.SysMenu">
        SELECT DISTINCT
            m.*
        FROM
            sys_user_role_rel urr
                LEFT JOIN sys_role_menu_rel rmr ON urr.role_id = rmr.role_id
                LEFT JOIN sys_menu m ON rmr.menu_id = m.id
        WHERE
            urr.user_id = #{userId}
            AND m.del_flag != 2
            <if test="(filters != null and filters.size() > 0)">
                AND m.menu_type IN
                <foreach collection="filters" item="menu" open="(" close=")" separator=",">
                    #{menu}
                </foreach>
            </if>
            <if test="(ignores != null and ignores.size() > 0)">
                AND m.menu_type NOT IN
                <foreach collection="ignores" item="menu" open="(" close=")" separator=",">
                    #{menu}
                </foreach>
            </if>
    </select>

</mapper>
