<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.doc.file.mapper.DocFileMapper">


    <select id="selectListNoAuth" resultType="com.platform.mesh.upms.api.modules.doc.domain.vo.DocFileVO">
        SELECT
            *
        FROM
            doc_file
        WHERE
            file_flag = #{fileFlag}
    </select>
</mapper>