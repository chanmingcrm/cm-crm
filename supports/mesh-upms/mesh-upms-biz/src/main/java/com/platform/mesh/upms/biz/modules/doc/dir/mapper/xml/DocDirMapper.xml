<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.doc.dir.mapper.DocDirMapper">

    <select id="selectHomePage" resultType="com.platform.mesh.upms.biz.modules.doc.dir.domain.po.DocDir">
        SELECT
            *
        FROM
            doc_dir
        <where>
            <if test="pageDTO.dirFlag != null">
                AND dir_flag = #{pageDTO.dirFlag}
            </if>
        </where>
    </select>

    <select id="getParentDir" resultType="com.platform.mesh.upms.biz.modules.doc.dir.domain.po.DocDir">
        SELECT
            *
        FROM
            doc_dir
        WHERE id = #{parentId}
    </select>

    <select id="getOneOpenDir" resultType="com.platform.mesh.upms.biz.modules.doc.dir.domain.po.DocDir">
        SELECT
            *
        FROM
            doc_dir
        WHERE open_flag = #{openFlag}
        ORDER BY parent_id
        LIMIT 1
    </select>

</mapper>