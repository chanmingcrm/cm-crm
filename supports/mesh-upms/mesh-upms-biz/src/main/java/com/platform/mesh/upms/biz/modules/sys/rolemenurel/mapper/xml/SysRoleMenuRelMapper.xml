<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.upms.biz.modules.sys.rolemenurel.mapper.SysRoleMenuRelMapper">


    <select id="selectPageRel"
            resultType="com.platform.mesh.upms.biz.modules.sys.rolemenurel.domain.vo.SysRoleMenuRelVO">
        SELECT
        sumr.*,
        sr.role_name,
        sm.name AS menu_name
        FROM
        sys_role_menu_rel sumr
        LEFT JOIN sys_role sr ON sr.id = sumr.role_id
        LEFT JOIN sys_menu sm ON sm.id = sumr.menu_id
        <where >
            <if test=" pageDTO.roleId != null ">
                AND sumr.role_id  =  #{pageDTO.roleId}
            </if>
            <if test=" pageDTO.menuId != null ">
                AND sumr.menu_id  = #{pageDTO.menuId}
            </if>
        </where>
    </select>
</mapper>
