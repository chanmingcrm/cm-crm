<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.gen.biz.modules.code.temp.mapper.CodeTemplateMapper">


    <select id="selectAllTempList"
            resultType="com.platform.mesh.gen.biz.modules.code.temp.domain.po.CodeTemplate">
        SELECT
            *
        FROM
            code_template
        <where>
            <if test="delFlag != null and delFlag != 0">
                AND del_flag = #{delFlag};
            </if>
        </where>
    </select>
</mapper>
