<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.ai.biz.modules.ai.job.mapper.AiJobMapper">

    <select id="getAllJob" resultType="com.platform.mesh.ai.biz.modules.ai.job.domain.po.AiJob">
        SELECT
            *
        FROM
            ai_job
        WHERE job_flag = #{jobFlag}
    </select>
</mapper>