<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.ai.biz.modules.ai.session.mapper.AiSessionMapper">


    <select id="selectMPage" resultType="com.platform.mesh.ai.biz.modules.ai.session.domain.vo.AiSessionVO">
        SELECT
            s.*,
            m.model_name
        FROM
            ai_session s
            LEFT JOIN ai_model m ON s.model_id = m.id
        <where>
            <if test="pageDTO.agentId != null">
                s.agent_id = #{pageDTO.agentId}
            </if>
        </where>
        ORDER BY
            s.create_time DESC
    </select>
</mapper>