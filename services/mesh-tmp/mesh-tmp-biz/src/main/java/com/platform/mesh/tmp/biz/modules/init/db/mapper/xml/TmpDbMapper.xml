<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.tmp.biz.modules.init.db.mapper.TmpDbMapper">

    <select id="selectAppTables" resultType="java.lang.String">
        SHOW TABLES LIKE '%_data';
    </select>

    <select id="dynamicDBMaxOne" resultType="java.util.Map">
        SELECT
            *
        FROM
            task_all_group
        <where>
            <if test=" createTime != null ">
                AND create_time &gt; #{createTime}
            </if>
        </where>
        ORDER BY
            id DESC
        LIMIT 1;
    </select>

    <insert id="dynamicDbInsert">
        INSERT INTO task_all_group
        <foreach collection="dataMap.keys" item="key" open="(" separator="," close=")">
            ${key}
        </foreach>
        VALUES
        <foreach collection="dataMap.values" item="value" open="(" separator="," close=")">
            #{value}
        </foreach>
    </insert>

    <delete id="dynamicDbDelete">
        DELETE
        FROM
            task_all_group
        WHERE
            id IN
            <foreach collection="dataIds" item="dataId" open="(" separator="," close=")">
                ${dataId}
            </foreach>
    </delete>

    <update id="dynamicDbUpdate">
        UPDATE
            task_all_group
        SET module_id = #{moduleId},update_time = NOW()
        WHERE
        id IN
        <foreach collection="dataIds" item="dataId" open="(" separator="," close=")">
            ${dataId}
        </foreach>
    </update>

    <delete id="dynamicDbDataDelete">
        DELETE
        FROM
            task_all_group
        WHERE
            data_id IN
            <foreach collection="dataIds" item="dataId" open="(" separator="," close=")">
                ${dataId}
            </foreach>
    </delete>
</mapper>