<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.app.biz.modules.app.formbase.mapper.AppFormBaseMapper">


    <select id="selectMPage" resultType="com.platform.mesh.app.biz.modules.app.formbase.domain.po.AppFormBase">
        SELECT
            afb.*
        FROM
            app_form_base afb
        WHERE
            afb.module_id = #{pageDTO.moduleId}
            AND IFNULL(afb.del_flag,0) != 2
            <if test=" pageDTO.formName !=null and pageDTO.formName!='' ">
                AND afb.form_name LIKE CONCAT('%',#{pageDTO.formName},'%')
            </if>
            <if test=" pageDTO.formType !=null">
                AND afb.form_type = #{pageDTO.formType}
            </if>
    </select>
</mapper>