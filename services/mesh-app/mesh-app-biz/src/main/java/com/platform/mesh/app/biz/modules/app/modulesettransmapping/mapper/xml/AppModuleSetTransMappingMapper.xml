<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.app.biz.modules.app.modulesettransmapping.mapper.AppModuleSetTransMappingMapper">


    <select id="getModuleSetTransMappingByTransId"
            resultType="com.platform.mesh.app.biz.modules.app.modulesettransmapping.domain.po.AppModuleSetTransMapping">
        SELECT
            *
        FROM
            app_module_set_trans_mapping
        WHERE
            trans_id = #{transId}
    </select>

    <select id="getModuleSetTransMappingByModuleId"
            resultType="com.platform.mesh.app.biz.modules.app.modulesettransmapping.domain.po.AppModuleSetTransMapping">
        SELECT
            *
        FROM
            app_module_set_trans_mapping
        WHERE
            from_module_id = #{fromModuleId}
          AND to_module_id = #{toModuleId}
    </select>
</mapper>