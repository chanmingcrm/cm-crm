        FROM crm_on_contract
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
            #{id}
        </foreach>
        AND del_flag = 1
    </select>

    <select id="todoAuditProposal"
            resultType="com.platform.mesh.crm.biz.modules.crm.preproposal.domain.po.CrmPreProposal">
        SELECT
        *
        FROM crm_pre_proposal
        WHERE id IN
        <foreach collection="ids" item="id" open="(" close=")" separator=",">
