<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.crm.biz.modules.crm.oncontract.mapper.CrmOnContractMapper">


    <select id="getTotalMoneyByCustomerId" resultType="java.math.BigDecimal">
        SELECT
            COALESCE(SUM(total_money), 0) AS total_money
        FROM
            crm_on_contract
        WHERE
            customer_id = #{customerId}
        AND process_pass = #{passFlag}
    </select>
</mapper>