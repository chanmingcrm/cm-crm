<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.platform.mesh.crm.biz.bi.tmp.mapper.TmpBiMapper">

    <select id="todoNumTodayPanel" resultType="com.platform.mesh.core.application.domain.vo.SimpVO">
        SELECT
            COUNT(1) AS value
        FROM
        tmp_task_base
        WHERE
        act_start_time &lt; #{biDTO.startTime} AND act_end_time &lt; #{biDTO.endTime}
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag !=null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND scope_org_id IN
                </when>
                <otherwise>
                    AND scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
    </select>

