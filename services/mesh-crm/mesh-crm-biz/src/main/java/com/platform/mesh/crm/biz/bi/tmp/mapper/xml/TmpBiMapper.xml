    <select id="handleTimeChart" resultType="com.platform.mesh.core.application.domain.vo.SimpVO">
        SELECT
        scope_user_id AS name,
        CONVERT(IFNULL(SUM(TIMESTAMPDIFF(MINUTE, act_start_time, act_end_time))/COUNT(1),0), DECIMAL(10,2)) AS value
        FROM
        tmp_task_base
        WHERE
        est_start_time &gt; #{biDTO.startTime} AND est_end_time &lt; #{biDTO.endTime}
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
