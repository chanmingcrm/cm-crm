    <select id="productSummary" resultType="com.platform.mesh.core.application.domain.vo.SimpVO">
        SELECT 'productTotal' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'materialTotal' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_material pm
        WHERE pm.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND pm.scope_org_id IN
                </when>
                <otherwise>
                    AND pm.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'zeroInventoryProductCount' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        AND IFNULL(p.product_num, 0) = 0
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'newThisMonth' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        AND p.create_time &gt; #{biDTO.startTime}
        AND p.create_time &lt; #{biDTO.endTime}
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'saleProduct' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        AND p.on_off_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'dataCompleteRate' AS name,
               IF(
                       COUNT(1) = 0,
                       0,
                       ROUND(
                               SUM(
                                       CASE
                                           WHEN p.cost_money IS NOT NULL
                                               AND p.sale_money IS NOT NULL
                                               AND p.product_num IS NOT NULL THEN 1
                                           ELSE 0
                                       END
                               ) * 100.0 / COUNT(1),
                               1
                       )
               ) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'abnormalProduct' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        AND (IFNULL(p.profit_money, 0) &lt; 0 OR IFNULL(p.product_num, 0) = 0 OR p.on_off_flag = 0)
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
    </select>

