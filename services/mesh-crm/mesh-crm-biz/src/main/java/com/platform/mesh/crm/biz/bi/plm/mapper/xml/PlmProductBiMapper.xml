    <select id="productHealth" resultType="com.platform.mesh.core.application.domain.vo.SimpVO">
        SELECT 'profile' AS name,
               IF(
                       COUNT(1) = 0,
                       0,
                       ROUND(
                               SUM(
                                       CASE
                                           WHEN p.cost_money IS NOT NULL
                                               AND p.sale_money IS NOT NULL
                                               AND p.product_num IS NOT NULL THEN 1
                                           ELSE 0
                                       END
                               ) * 100.0 / COUNT(1),
                               1
                       )
               ) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'quality' AS name,
               IF(
                       COUNT(1) = 0,
                       0,
                       ROUND(
                               SUM(
                                       CASE
                                           WHEN IFNULL(p.profit_money, 0) &gt;= 0 THEN 1
                                           ELSE 0
                                       END
                               ) * 100.0 / COUNT(1),
                               1
                       )
               ) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'sales' AS name,
               IF(
                       COUNT(1) = 0,
                       0,
                       ROUND(
                               SUM(
                                       CASE
                                           WHEN p.on_off_flag = 1
                                               AND IFNULL(p.product_num, 0) &gt; 0 THEN 1
                                           ELSE 0
                                       END
                               ) * 100.0 / COUNT(1),
                               1
                       )
               ) AS value,
               NULL AS extend_value
        FROM plm_product p
        WHERE p.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'supply' AS name,
               IF(product_count = 0, NULL, ROUND(sku_count * 100.0 / product_count, 1)) AS value,
               NULL AS extend_value
        FROM (
            SELECT (
                       SELECT COUNT(1)
                       FROM plm_product
                       WHERE del_flag = 1
                   ) AS product_count,
                   (
                       SELECT COUNT(DISTINCT product_material_id)
                       FROM srm_product
                       WHERE del_flag = 1
                   ) AS sku_count
        ) t
    </select>

    <select id="productOperation" resultType="com.platform.mesh.core.application.domain.vo.SimpVO">
