        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND p.scope_org_id IN
                </when>
                <otherwise>
                    AND p.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'skuTotal' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_material pm
        WHERE pm.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND sp.scope_org_id IN
                </when>
                <otherwise>
                    AND sp.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'enabledSku' AS name,
               COUNT(DISTINCT sp.product_material_id) AS value,
               NULL AS extend_value
        FROM srm_product sp
        INNER JOIN plm_material pm ON sp.product_material_id  = pm.id
        WHERE sp.del_flag = 1 AND pm.del_flag = 1
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND sp.scope_org_id IN
                </when>
                <otherwise>
                    AND sp.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
        UNION ALL
        SELECT 'disabledSku' AS name,
               COUNT(1) AS value,
               NULL AS extend_value
        FROM plm_material pm
        WHERE pm.del_flag = 1
        AND NOT EXISTS (
            SELECT 1
            FROM srm_product sp
            WHERE sp.product_material_id = pm.id
            AND sp.del_flag = 1
        )
        <if test="(biDTO.dataIds != null and biDTO.dataIds.size() > 0)">
            <choose>
                <when test="biDTO.dataFlag != null and biDTO.dataFlag == @com.platform.mesh.core.enums.data.DataFlagEnum@ORG.getValue()">
                    AND sp.scope_org_id IN
                </when>
                <otherwise>
                    AND sp.scope_user_id IN
                </otherwise>
            </choose>
            <foreach collection="biDTO.dataIds" item="dataId" open="(" close=")" separator=",">
                #{dataId}
            </foreach>
        </if>
